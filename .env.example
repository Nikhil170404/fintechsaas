SECRET_KEY=change-this-to-a-random-secret-key

# Company branding
COMPANY_NAME=FinTech Solutions Pvt Ltd
SENDER_NAME=FinTech Solutions

# SMTP (Gmail example — use App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password

# For Outlook / Office365
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587

# For custom SMTP server
# SMTP_HOST=mail.yourcompany.com
# SMTP_PORT=587

# System/transactional SMTP — used only for password-reset emails.
# Separate from the SMTP_* above, which each tenant configures themselves
# for sending statements to their own clients. If left blank, reset links
# are written to that tenant's audit log instead (visible via Settings > Audit Log
# to an owner, or in the server logs) so local/dev use still works without real SMTP.
SYS_SMTP_HOST=smtp.gmail.com
SYS_SMTP_PORT=587
SYS_SMTP_USER=
SYS_SMTP_PASS=
