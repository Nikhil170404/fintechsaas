# Example nginx reverse-proxy config for FinTech SaaS.
# Copy to /etc/nginx/sites-available/fintech-saas, replace your-domain.com,
# symlink into sites-enabled, then run certbot to add HTTPS.
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/fintech-saas
#   sudo ln -s /etc/nginx/sites-available/fintech-saas /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d your-domain.com
#
# certbot (Let's Encrypt) will rewrite this file to add the HTTPS server block
# and redirect automatically — you don't need to add SSL directives by hand.

server {
    listen 80;
    server_name your-domain.com;

    client_max_body_size 20M;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
